+++ b/test/gymmaster-member-two-hour-session.test.js
@@ -0,0 +1,75 @@
+"use strict";
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const {
+  TWO_HOUR_SESSION_TTL_SECONDS, buildGymMasterTwoHourSessionCookie,
+  clearGymMasterTwoHourSessionCookie, createGymMasterTwoHourSessionService,
+  tokenHash, twoHourSessionEnabled,
+} = require("../src/goals-coach/gymmaster-member-session");
+
+function poolFor(workQuery, releases = []) {
+  return { async connect() { return { async query(sql, values) {
+    if (sql === "BEGIN" || sql === "COMMIT" || sql === "ROLLBACK" || sql.includes("set_config")) return { rows: [] };
+    return workQuery(sql, values);
+  }, release(error) { releases.push(error || null); } }; } };
+}
+
+test("two-hour capability uses an exact disabled-by-default flag", () => {
+  assert.equal(twoHourSessionEnabled(undefined), false);
+  for (const value of ["TRUE", " true", "true ", "1", true]) assert.equal(twoHourSessionEnabled(value), false);
+  assert.equal(twoHourSessionEnabled("true"), true);
+  assert.equal(TWO_HOUR_SESSION_TTL_SECONDS, 7200);
+});
+
+test("opaque token is hashed, scoped, and accepted just before but not at expiry", async () => {
+  let clock = new Date("2026-01-01T00:00:00.000Z"); let stored;
+  const db = poolFor(async (sql, values) => {
+    if (sql.includes("INSERT INTO")) { stored = { hash: values[0], issued: values[3] }; return { rows: [] }; }
+    const expires = new Date(stored.issued.getTime() + 7200000);
+    if (values[0] === stored.hash && values[1] < expires) return { rows: [{ auth_mapping_id: "5", member_id: "9", auth_provider: "gymmaster", auth_subject: "gymmaster:7" }] };
+    return { rows: [] };
+  });
+  const service = createGymMasterTwoHourSessionService({ db, now: () => clock, randomBytes: () => Buffer.alloc(32, 7) });
+  const token = await service.issue({ authProvider: "gymmaster", authSubject: "gymmaster:7" }, { active: true, mappingId: "5", memberId: "9" });
+  assert.match(token, /^[A-Za-z0-9_-]{43}$/); assert.equal(stored.hash, tokenHash(token)); assert.notEqual(stored.hash, token);
+  assert.equal(buildGymMasterTwoHourSessionCookie(token), `gc_member_session=${token}; Path=/goalscoach; HttpOnly; Secure; SameSite=Strict; Max-Age=7200`);
+  assert.equal(clearGymMasterTwoHourSessionCookie(), "gc_member_session=; Path=/goalscoach; HttpOnly; Secure; SameSite=Strict; Max-Age=0");
+  clock = new Date("2026-01-01T01:59:59.999Z"); assert.equal((await service.verify(token)).memberId, "9");
+  clock = new Date("2026-01-01T02:00:00.000Z"); await assert.rejects(service.verify(token), /invalid or expired/);
+  await assert.rejects(service.verify("malformed"), /invalid or expired/);
+});
+
+test("revocation is token-hash scoped and database errors fail closed", async () => {
+  const calls = []; const db = poolFor(async (sql, values) => { calls.push({ sql, values }); if (sql.includes("UPDATE")) return { rows: [{ id: 1 }] }; return { rows: [] }; });
+  const service = createGymMasterTwoHourSessionService({ db }); const token = Buffer.alloc(32, 3).toString("base64url");
+  assert.equal(await service.revoke(token), true); assert.equal(calls[0].values[0], tokenHash(token));
+  const failed = createGymMasterTwoHourSessionService({ db: poolFor(async () => { throw new Error("unavailable"); }) });
+  await assert.rejects(failed.verify(token), /Bounded database transaction/);
+});
+
+test("hung acquisition terminates and safely releases a late client", async () => {
+  const releases = []; let resolveConnect;
+  const db = { connect: () => new Promise((resolve) => { resolveConnect = resolve; }) };
+  const service = createGymMasterTwoHourSessionService({ db, acquisitionMilliseconds: 10, phaseMilliseconds: 20, overallMilliseconds: 30 });
+  const keepAlive = setTimeout(() => {}, 40);
+  const pending = service.issue({ authProvider: "gymmaster", authSubject: "gymmaster:7" }, { active: true, mappingId: "5", memberId: "9" });
+  await assert.rejects(pending, (error) => error.code === "checkout_terminal");
+  clearTimeout(keepAlive);
+  resolveConnect({ release(error) { releases.push(error || null); } });
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(releases.length, 1);
+});
+
+for (const operation of ["issue", "verify", "revoke"]) {
+  test(`${operation} fails closed when its protected database statement times out`, async () => {
+    const releases = [];
+    const db = poolFor(() => new Promise((_resolve, reject) => setTimeout(() => reject(new Error("statement timeout")), 12)), releases);
+    const service = createGymMasterTwoHourSessionService({ db, acquisitionMilliseconds: 10, phaseMilliseconds: 10, overallMilliseconds: 20 });
+    const token = Buffer.alloc(32, 3).toString("base64url");
+    const call = operation === "issue"
+      ? service.issue({ authProvider: "gymmaster", authSubject: "gymmaster:7" }, { active: true, mappingId: "5", memberId: "9" })
+      : service[operation](token);
+    await assert.rejects(call, /Bounded database transaction/);
+    assert.equal(releases.length, 1);
+  });
+}
