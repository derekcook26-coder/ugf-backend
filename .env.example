GYMMASTER_API_KEY=your_gymmaster_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Public UGF website widgets. Disabled by default. The Member Portal API key is
# a separate credential and must never fall back to GYMMASTER_API_KEY.
UGF_GYMMASTER_WIDGETS_ENABLED=false
UGF_GYMMASTER_WIDGETS_ORIGIN=https://ultimategoalsfitness.com
GYMMASTER_MEMBER_PORTAL_API_BASE_URL=https://ugf.gymmasteronline.com/portal/api/v1/
GYMMASTER_MEMBER_PORTAL_API_KEY=

# Deterministic public help chat. Disabled by default and has no member-data access.
UGF_PUBLIC_HELP_CHAT_ENABLED=false
UGF_PUBLIC_HELP_CHAT_ORIGIN=https://ultimategoalsfitness.com
UGF_HELP_MEMBERSHIP_URL=https://ugf.gymmasteronline.com/portal/signup?logo=0
UGF_HELP_SCHEDULE_URL=https://ultimategoalsfitness.com/
UGF_HELP_WORKOUT_URL=https://ultimategoalsfitness.com/coachai
UGF_HELP_MEMBER_PORTAL_URL=https://ugf.gymmasteronline.com/portal/login
UGF_HELP_CONTACT_URL=https://ultimategoalsfitness.com/

# Authenticated member private shell. Disabled by default.
GOALS_COACH_MEMBER_PRIVATE_SCREEN_ENABLED=false
GOALS_COACH_MEMBER_PRIVATE_SCREEN_LOGIN_ENABLED=false
GOALS_COACH_MEMBER_SAFETY_INTAKE_ALPHA_ENABLED=false
GOALS_COACH_MEMBER_COACHING_CONSENT_ENABLED=false
GOALS_COACH_MEMBER_TODAY_ENABLED=false

# Goals Coach Phase 1A private-alpha foundation. Disabled by default.
GOALS_COACH_ALPHA_ENABLED=false
GOALS_COACH_ALPHA_ENVIRONMENT=development
GOALS_COACH_ALPHA_CONSENT_VERSION=GC-ALPHA-CONSENT-1.0
GOALS_COACH_ALPHA_DEVELOPMENT_ORIGINS=http://localhost:3100
GOALS_COACH_ALPHA_ORIGIN=
GOALS_COACH_MEMBER_CLERK_SECRET_KEY=
GOALS_COACH_MEMBER_CLERK_PUBLISHABLE_KEY=
GOALS_COACH_MEMBER_CLERK_ISSUER=
GOALS_COACH_MEMBER_CLERK_AUDIENCE=goals-coach-alpha-api

# Goals Coach Phase 1B coaching intelligence. Disabled by default. The current
# startup has no live provider adapter and therefore remains fail closed even
# when these non-secret identifiers are prepared.
GOALS_COACH_AI_ENABLED=false
GOALS_COACH_AI_PROVIDER=
GOALS_COACH_OPENAI_MODEL=
GOALS_COACH_PROMPT_VERSION=
GOALS_COACH_STRUCTURED_OUTPUT_VERSION=
GOALS_COACH_SAFETY_RULE_VERSION=phase-1b-placeholder
GOALS_COACH_PROVIDER_TIMEOUT_MS=15000
